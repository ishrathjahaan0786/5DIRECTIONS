# 5Directions Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas Persistent Database Connection
# Replace with your MongoDB Atlas cluster URI or local MongoDB
MONGODB_URI=mongodb://localhost:27017/5directions

# Server-Side Session Security (express-session)
# Provide a cryptographically secure random secret
SESSION_SECRET=5directions_resilience_session_secret_change_in_production_2026

# Allowed Frontend Origin (for CORS in development / production)
# In production on Render, set this to your Vercel deployment URL
FRONTEND_URL=http://localhost:5173

# Google Gemini API Configuration (Server-Side Only - Never expose to client)
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
